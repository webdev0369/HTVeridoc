# Copy to .env before: docker compose up --build
# Browser-facing URLs must be reachable from your machine / users (not Docker DNS names).

POSTGRES_USER=htveridoc
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=htveridoc
POSTGRES_PORT=5432
REDIS_PORT=6379

# JWT (min 16 chars; use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!!
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=7d

# API / web public URLs
API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Gemini (required for extraction)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Encrypts per-organization integration secrets
INTEGRATIONS_SECRET_KEY=

# Overridden inside Compose for containers; kept here for local tooling
DATABASE_URL=postgresql://htveridoc:change-me-strong-db-password@localhost:5432/htveridoc
REDIS_URL=redis://localhost:6379
STORAGE_ROOT=/data/storage
MAX_UPLOAD_BYTES=26214400
