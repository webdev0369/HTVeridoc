{
  "name": "htveridoc",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "with-node": "node scripts/with-project-node.js",
    "dev": "node scripts/dev.js",
    "dev:api": "node scripts/with-project-node.js pnpm --filter @htveridoc/api dev",
    "dev:web": "node scripts/with-project-node.js pnpm --filter @htveridoc/web dev",
    "build": "node scripts/with-project-node.js pnpm -r run build",
    "lint": "node scripts/with-project-node.js pnpm -r run lint",
    "migration:run": "node scripts/with-project-node.js pnpm --filter @htveridoc/api migration:run",
    "migration:generate": "node scripts/with-project-node.js pnpm --filter @htveridoc/api migration:generate",
    "seed": "node scripts/with-project-node.js pnpm --filter @htveridoc/api seed",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=20"
  }
}
