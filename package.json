{
  "name": "htveridoc",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "with-node": "node scripts/with-project-node.js",
    "dev": "node scripts/dev-micro.js",
    "dev:identity": "node scripts/with-project-node.js pnpm --filter @htveridoc/identity dev",
    "dev:documents": "node scripts/with-project-node.js pnpm --filter @htveridoc/documents dev",
    "dev:processing": "node scripts/with-project-node.js pnpm --filter @htveridoc/processing dev",
    "dev:review": "node scripts/with-project-node.js pnpm --filter @htveridoc/review dev",
    "dev:integrations": "node scripts/with-project-node.js pnpm --filter @htveridoc/integrations dev",
    "dev:gateway": "node scripts/with-project-node.js pnpm --filter @htveridoc/gateway dev",
    "dev:web": "node scripts/with-project-node.js pnpm --filter @htveridoc/web dev",
    "build": "node scripts/with-project-node.js pnpm -r run build",
    "lint": "node scripts/with-project-node.js pnpm -r run lint",
    "migration:run": "node scripts/with-project-node.js pnpm --filter @htveridoc/db migration:run",
    "seed": "node scripts/with-project-node.js pnpm --filter @htveridoc/db seed",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=20"
  }
}
