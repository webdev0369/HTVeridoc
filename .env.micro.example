# Microservices profile — copy to .env.micro (gitignored) on the micro-services branch:
#   cp .env.micro.example .env.micro
#
# scripts/dev.js / with-project-node.js sync .env.micro → .env when the branch
# name contains "micro" (or HTVERIDOC_ENV=micro).

NODE_ENV=development
DATABASE_URL=postgresql://postgres:1234@localhost:5432/htveridoc
# Use 6380 if host 6379 is taken by an old Windows Redis
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=7d
# Relative to apps/api/<service> cwd (gateway, documents, …)
STORAGE_ROOT=../../../storage/htveridoc
MAX_UPLOAD_BYTES=26214400
API_PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Web talks to the gateway (fans out to microservices)
NEXT_PUBLIC_API_URL=http://localhost:3001
