# PostgreSQL (local install, or use Docker Compose — see .env.docker.example)
DATABASE_URL=postgresql://htveridoc:htveridoc@localhost:5432/htveridoc

# Redis (optional for Phases 1–3; required later for BullMQ jobs)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=7d

# Storage
# Relative to apps/api when running the Nest process
STORAGE_ROOT=../../storage/htveridoc
MAX_UPLOAD_BYTES=26214400

# API
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Gemini (Phase 4+)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Encrypts per-organization integration secrets (export API keys, etc.)
# Prefer a dedicated key in production. If empty, JWT_ACCESS_SECRET is used.
INTEGRATIONS_SECRET_KEY=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
